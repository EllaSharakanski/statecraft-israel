---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, type Page, dir, href, asset, ogLocale, otherLang, t, CSP } from '../i18n/ui';
import { captures } from '../lib/media';
const ogSource = captures[0].src;

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description?: string;
  jsonLd?: object;
  /** Images to preload (the LCP image), as from getImage. */
  preload?: { srcset: string; sizes: string; type: string }[];
  noindex?: boolean;
}

const { lang, page, title, description = t(lang, 'site.tagline'), jsonLd, preload = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${t(lang, 'site.name')}` : t(lang, 'site.name');
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(href(lang, page));
const alternates = [
  { hreflang: 'en', url: abs(href('en', page)) },
  { hreflang: 'he', url: abs(href('he', page)) },
  { hreflang: 'x-default', url: abs(href(null)) },
];
// The social card is a real screenshot of the build, never concept art.
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogAlt = captures[0].alt[lang];

const fontFaces = `
@font-face { font-family: 'EB Garamond'; font-weight: 400; font-style: normal; font-display: swap; src: url('${asset('fonts/EBGaramond-Regular.latin.woff2')}') format('woff2'); }
@font-face { font-family: 'EB Garamond'; font-weight: 500 700; font-style: normal; font-display: swap; src: url('${asset('fonts/EBGaramond-SemiBold.latin.woff2')}') format('woff2'); }
@font-face { font-family: 'Frank Ruhl Libre'; font-weight: 400; font-style: normal; font-display: swap; src: url('${asset('fonts/FrankRuhlLibre-Regular.woff2')}') format('woff2'); }
@font-face { font-family: 'Frank Ruhl Libre'; font-weight: 500 700; font-style: normal; font-display: swap; src: url('${asset('fonts/FrankRuhlLibre-Medium.woff2')}') format('woff2'); }`;
const bodyFont = lang === 'he' ? 'fonts/FrankRuhlLibre-Regular.woff2' : 'fonts/EBGaramond-Regular.latin.woff2';
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.url} />)}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#090e1a" />
    <link rel="preload" href={asset(bodyFont)} as="font" type="font/woff2" crossorigin />
    {preload.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} type={p.type} fetchpriority="high" />)}
    <style set:html={fontFaces}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(lang, 'site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:locale:alternate" content={ogLocale(otherLang(lang))} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
  </body>
</html>
