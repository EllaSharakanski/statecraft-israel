---
// The language chooser at the site root, which hreflang names as x-default. No automatic redirect.
import '../styles/global.css';
import { href, asset } from '../i18n/ui';
const abs = (p: string) => new URL(p, Astro.site).href;
const csp = "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'";
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>Statecraft: Israel</title>
    <meta name="description" content="A turn-based strategy game about governing Israel from 15 May 1948. English and Hebrew." />
    <link rel="canonical" href={abs(href(null))} />
    <link rel="alternate" hreflang="en" href={abs(href('en'))} />
    <link rel="alternate" hreflang="he" href={abs(href('he'))} />
    <link rel="alternate" hreflang="x-default" href={abs(href(null))} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#090e1a" />
    <style set:html={`@font-face { font-family: 'EB Garamond'; font-weight: 400; font-display: swap; src: url('${asset('fonts/EBGaramond-Regular.latin.woff2')}') format('woff2'); }
@font-face { font-family: 'Frank Ruhl Libre'; font-weight: 400; font-display: swap; src: url('${asset('fonts/FrankRuhlLibre-Regular.woff2')}') format('woff2'); }`}></style>
  </head>
  <body>
    <main class="chooser">
      <h1>Statecraft: Israel</h1>
      <div class="choices">
        <a class="btn btn-primary" href={href('en')} hreflang="en">English</a>
        <a class="btn btn-primary" href={href('he')} hreflang="he" lang="he" dir="rtl">עברית</a>
      </div>
      <p>A turn-based strategy game about governing Israel from 15 May 1948.</p>
      <p lang="he" dir="rtl">משחק אסטרטגיה מבוסס־תורות על ניהול מדינת ישראל מ־15 במאי 1948.</p>
    </main>
  </body>
</html>
<style>
  .chooser { min-block-size: 100svh; display: grid; place-content: center; text-align: center; gap: 0.5rem; padding: 2rem 1rem; }
  .choices { display: flex; gap: 1rem; justify-content: center; margin-block: 1rem 1.5rem; }
  .chooser p { color: var(--ink-dim); margin: 0; }
  [lang='he'] { font-family: var(--serif-he); }
</style>
