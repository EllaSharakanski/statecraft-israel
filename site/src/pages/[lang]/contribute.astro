---
import ProsePage from '../../components/ProsePage.astro';
import { type Lang, languages, REPO } from '../../i18n/ui';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
---
<ProsePage lang={lang} page="contribute" name="contribute" navKey="nav.contribute"
  heading={he ? 'איך משתתפים' : 'Contribute'}
  description={he ? 'איך לעזור ב־Statecraft: Israel: קוד, מחקר היסטורי, תרגום ואמנות.' : 'How to help with Statecraft: Israel: code, history research, translation and art.'}>
  <div class="btn-row" style="margin-block-start:2rem">
    <a class="btn btn-primary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING.md</a>
    <a class="btn" href={`${REPO}/issues`}>{he ? 'בעיות פתוחות' : 'Open issues'}</a>
  </div>
</ProsePage>
