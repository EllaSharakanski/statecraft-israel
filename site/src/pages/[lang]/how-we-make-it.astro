---
// The AI policy, drawn from README's "AI use" section and from ASSETS.yaml: the table lists every row flagged
// ai_generated: true, read at build time.
import ProsePage from '../../components/ProsePage.astro';
import { type Lang, languages, repoFile } from '../../i18n/ui';
import { assetRules } from '../../lib/repo';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
const rows = assetRules().filter((r) => r.ai_generated);
const status = (s: string) => s === 'verified'
  ? (he ? 'נבדק' : 'verified')
  : (he ? 'ממתין לבדיקת הבעלים' : 'awaiting the owner’s check');
---
<ProsePage lang={lang} page="how-we-make-it" name="how-we-make-it" navKey="nav.how"
  heading={he ? 'איך המשחק נעשה' : 'How we make it'}
  intro={he ? 'מדיניות הבינה המלאכותית של הפרויקט, ומה נעשה בלעדיה.' : 'The project’s AI policy, and what is made without AI.'}
  description={he ? 'במה Statecraft: Israel משתמש בבינה מלאכותית, ובמה לא.' : 'What Statecraft: Israel uses AI for, and what it does not.'}>
  <section aria-labelledby="ai-files">
    <h2 id="ai-files">{he ? 'קבצים שנוצרו בבינה מלאכותית' : 'AI-generated files'}</h2>
    <p class="muted prose">{he
      ? `${rows.length} שורות ב־ASSETS.yaml מסומנות כתוצר של בינה מלאכותית. התיאורים מוצגים כפי שהם במאגר (באנגלית). "ממתין לבדיקת הבעלים" פירושו שתנאי השימוש של הכלי עדיין נבדקים.`
      : `${rows.length} rows in ASSETS.yaml are flagged as AI output. The descriptions are shown as they are in the repository. “Awaiting the owner’s check” means the tool’s terms of use are still being checked.`}</p>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th scope="col">{he ? 'קבצים' : 'Files'}</th>
          <th scope="col">{he ? 'איך נוצרו' : 'How they were made'}</th>
          <th scope="col">{he ? 'רישיון' : 'Licence'}</th>
          <th scope="col">{he ? 'מצב' : 'Status'}</th>
        </tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td dir="ltr" class="files"><code>{r.glob}</code></td>
              <td lang="en" dir="ltr" class="how">{r.source}</td>
              <td dir="ltr">{r.licence}</td>
              <td>{status(r.status)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="prose"><a href={repoFile('ASSETS.yaml')}>ASSETS.yaml</a> · <a href={repoFile('docs/ai-disclosure.md')}>docs/ai-disclosure.md</a></p>
  </section>
</ProsePage>
<style>
  section { margin-block-start: 2.5rem; }
  td.how { font-size: 0.85rem; color: var(--ink-dim); min-inline-size: 22rem; max-inline-size: 40rem; }
  td.files { white-space: nowrap; }
</style>
