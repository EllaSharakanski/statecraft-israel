---
import ProsePage from '../../components/ProsePage.astro';
import { type Lang, languages, REPO } from '../../i18n/ui';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
---
<ProsePage lang={lang} page="play" name="play" navKey="nav.play"
  heading={he ? 'לשחק' : 'Play'}
  intro={he ? 'אב־טיפוס 0.1.0 (M3), 11 באוקטובר 2026.' : 'Prototype 0.1.0 (M3), 11 October 2026.'}
  description={he ? 'איך משחקים ב־Statecraft: Israel היום, ומה צריך כדי לארח את גרסת הדפדפן באתר.' : 'How to play Statecraft: Israel today, and what hosting the browser build on this site needs.'}>
  <div class="btn-row" style="margin-block-start:2rem">
    <a class="btn btn-primary" href={`${REPO}/blob/main/BUILDING.md`}>{he ? 'הוראות הבנייה (באנגלית)' : 'Build instructions'}</a>
    <a class="btn" href={REPO}>GitHub</a>
  </div>
</ProsePage>
