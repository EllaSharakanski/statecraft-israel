---
import ProsePage from '../../components/ProsePage.astro';
import { type Lang, languages } from '../../i18n/ui';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
---
<ProsePage lang={lang} page="privacy" name="privacy" navKey="nav.privacy"
  heading={he ? 'פרטיות' : 'Privacy'}
  description={he ? 'בלי אנליטיקה, בלי עוגיות ובלי טעינה מאתרים אחרים.' : 'No analytics, no cookies and nothing loaded from other sites.'} />
