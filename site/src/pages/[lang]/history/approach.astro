---
// A content note and the design rules on war, displacement, immigration and violence against civilians. The text
// (src/content/<lang>/approach.md) only restates docs/CONTENT_POLICY.md and docs/GDD.md with its owner rulings.
import ProsePage from '../../../components/ProsePage.astro';
import { type Lang, languages } from '../../../i18n/ui';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
---
<ProsePage lang={lang} page="history/approach" name="approach" navKey="nav.approach"
  heading={he ? 'איך המשחק מתייחס להיסטוריה' : 'How the game treats history'}
  intro={he ? 'אזהרת תוכן, והכללים שהמשחק שומר בנוגע למלחמה, לעקירה, לעלייה ולאלימות נגד אזרחים.' : 'A content note, and the rules the game keeps on war, displacement, immigration and violence against civilians.'}
  description={he ? 'אזהרת תוכן ועקרונות העיצוב של Statecraft: Israel: נקודת המבט, אפשרות הגירוש, אלימות נגד אזרחים ומקורות.' : 'A content note and the design rules of Statecraft: Israel: the perspective, the Deport outcome, violence against civilians and sources.'} />
