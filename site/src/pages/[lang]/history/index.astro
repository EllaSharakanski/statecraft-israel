---
// History first, then the mechanics: every event in content/events/, in the game's order, with the game's own sourced
// text, its sources and the decision it puts to the player. Nothing on this page is written for the website.
import fs from 'node:fs';
import path from 'node:path';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import MediaLabel from '../../../components/MediaLabel.astro';
import { type Lang, languages, href, t, formatDate, repoFile } from '../../../i18n/ui';
import { events, eventPhotos, repoRoot } from '../../../lib/repo';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';

const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../../../../../unity/Assets/UI/EventImages/*.jpg', { eager: true });
const photoByFile = new Map(Object.entries(photoFiles).map(([p, m]) => [p.split('/').pop()!, m.default]));
const photos = eventPhotos();
const list = events();
const years = [...new Set(list.map((e) => e.from.slice(0, 4)))];

// The two lines the game's start screen quotes, checked word for word against the repository's copies of the
// Declaration (docs/sources/declaration-1948), as StartScreenTests does in the game.
const declaration = {
  he: ['…אנו מכריזים בזאת על הקמת מדינה יהודית בארץ־ישראל, היא מדינת ישראל.', 'בעיר תל־אביב, היום הזה, ערב שבת, ה׳ אייר תש״ח, 14 במאי 1948.'],
  en: ['…HEREBY DECLARE THE ESTABLISHMENT OF A JEWISH STATE IN ERETZ-ISRAEL, TO BE KNOWN AS THE STATE OF ISRAEL.', 'IN THE CITY OF TEL-AVIV, ON THIS SABBATH EVE, THE 5TH DAY OF IYAR, 5708 (14TH MAY, 1948).'],
};
for (const l of ['he', 'en'] as const) {
  const src = fs.readFileSync(path.join(repoRoot, `docs/sources/declaration-1948/${l}.txt`), 'utf8');
  for (const line of declaration[l]) {
    if (!src.includes(line.replace(/^…/, ''))) throw new Error(`history: declaration line not found in ${l}.txt: ${line}`);
  }
}

const host = (u: string) => { try { const x = new URL(u); return x.hostname.replace(/^www\./, '') + decodeURIComponent(x.pathname).replace(/\/$/, ''); } catch { return u; } };
const sensitiveCount = list.filter((e) => e.status === 'sensitivity-reviewed').length;
---
<Layout lang={lang} page="history" title={t(lang, 'nav.history')}
  description={he ? 'כל האירועים ההיסטוריים במשחק, 1948 עד 1951, עם המקורות שלהם וההחלטה שהמשחק מציב.' : 'Every historical event in the game, 1948 to 1951, with its sources and the decision the game puts to the player.'}>
  <div class="wrap page">
    <header class="page-head">
      <span class="eyebrow">{t(lang, 'nav.history')}</span>
      <h1>{he ? '1948 עד 1951, אירוע אחר אירוע' : '1948 to 1951, event by event'}</h1>
      <p>{he
        ? `העמוד מציג את ${list.length} האירועים ההיסטוריים שבמשחק, לפי הסדר שבו השחקן פוגש אותם. בכל אירוע מופיע קודם מה שקרה, בטקסט של המשחק עצמו ועם המקורות שלו, ואחר כך ההחלטה שהמשחק מציב. הטקסטים והמקורות נלקחים כמו שהם מתיקיית content במאגר.`
        : `This page lists the ${list.length} historical events in the game, in the order the player meets them. Each one shows first what happened, in the game's own text with its sources, then the decision the game puts to the player. The text and the sources are taken as they are from the repository's content folder.`}</p>
    </header>

    <section class="opening" aria-labelledby="opening">
      <h2 id="opening" class="visually-hidden">{he ? 'נקודת הפתיחה' : 'The starting point'}</h2>
      <div class="declaration panel">
        <p class="decl-he" lang="he" dir="rtl">{declaration.he[0]}</p>
        <p class="decl-en" lang="en" dir="ltr">{declaration.en[0]}</p>
        <p class="decl-he" lang="he" dir="rtl">{declaration.he[1]}</p>
        <p class="decl-en" lang="en" dir="ltr">{declaration.en[1]}</p>
        <p class="decl-source">{he
          ? 'מתוך ההכרזה על הקמת מדינת ישראל (עיתון רשמי מס׳ 1, 14 במאי 1948) ותרגומה הרשמי לאנגלית. אלה השורות שמסך הפתיחה של המשחק מצטט.'
          : 'From the Declaration of the Establishment of the State of Israel (Official Gazette No. 1, 14 May 1948) and its official English translation. These are the lines the game’s start screen quotes.'}
          {' '}<a href={repoFile('docs/sources/declaration-1948/he.txt')}>{he ? 'הנוסח המלא' : 'Full text'}</a></p>
      </div>
      <div class="prose">
        <p>{he
          ? 'המשחק מתחיל למחרת, ב־15 במאי 1948, ואתם ראש הממשלה.'
          : 'The game starts the next day, on 15 May 1948, with you as prime minister.'}</p>
        <p class="note">{he
          ? 'המשחק עוסק במלחמה, בטרור ובשואה כאירועים היסטוריים. המסגור שלו ישראלי. כל צילום ארכיון בעמוד הזה הוא צילום אמיתי עם קרדיט ורישיון; אין בעמוד תמונות שנוצרו בבינה מלאכותית.'
          : 'The game deals with war, terror and the Holocaust as historical events. Its framing is Israeli. Every archival photograph on this page is a real photograph with its credit and licence; there are no AI-generated images on this page.'}</p>
        {he && <p class="note">{t(lang, 'history.en-only')} {'כותרות האירועים, הטקסטים והאפשרויות מוצגים כאן כפי שהם מופיעים במשחק.'}</p>}
      </div>
    </section>

    <nav class="years" aria-label={he ? 'שנים' : 'Years'}>
      {years.map((y) => <a href={`#y${y}`}>{y}</a>)}
      <a href="#how">{he ? 'איך זה עובד במשחק' : 'How it works in the game'}</a>
    </nav>

    {years.map((y) => (
      <section class="year" aria-labelledby={`y${y}`}>
        <h2 id={`y${y}`} class="year-title">{y}</h2>
        {list.filter((e) => e.from.startsWith(y)).map((e) => {
          const ph = photos.get(e.id);
          const img = ph && photoByFile.get(ph.file);
          return (
            <article class="event" id={e.id}>
              {img && ph && (
                <figure class="media event-photo" data-kind="archival">
                  <div class="media-frame">
                    <MediaLabel lang={lang} kind="archival" />
                    <Picture src={img} alt={ph.alt} lang="en" formats={['avif']} fallbackFormat="webp" widths={[400, 720]}
                      sizes="(min-width: 60rem) 22rem, 100vw" loading="lazy" />
                  </div>
                  <figcaption><span lang="en" dir="ltr">{ph.credit}</span> · <a href={ph.commons}>Wikimedia Commons</a></figcaption>
                </figure>
              )}
              <div class="event-body">
                <p class="event-date">{t(lang, 'date.window')}{he ? '' : ' '}<time datetime={e.from}>{formatDate(lang, e.from)}</time></p>
                <h3 lang="en" dir="ltr">{e.title}</h3>
                <p class="event-text" lang="en" dir="ltr">{e.text}</p>
                <div class="choice">
                  <h4>{t(lang, 'history.choice')}</h4>
                  <ul>
                    {e.options.map((o) => (
                      <li class:list={{ historical: o.historical }}>
                        <span lang="en" dir="ltr">{o.text}</span>
                        {o.historical && <span class="tag">{t(lang, 'history.historical')}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
                <details class="sources">
                  <summary>{t(lang, 'history.sources')} ({e.sources.length}) · {t(lang, 'history.status')}: {t(lang, `history.status.${e.status}` as 'history.status.fact-checked')}</summary>
                  <ul>
                    {e.sources.map((s) => (
                      <li><a href={s.url} class="ltr">{host(s.url)}</a>{s.checked && <span class="muted"> · {he ? 'נבדק ב־' : 'checked '}{formatDate(lang, s.checked)}</span>}</li>
                    ))}
                  </ul>
                  <p><a href={repoFile(`content/events/${e.id}.yaml`)}>{he ? 'קובץ האירוע במאגר' : 'The event file in the repository'}</a></p>
                </details>
              </div>
            </article>
          );
        })}
      </section>
    ))}

    <section class="how prose" aria-labelledby="how">
      <h2 id="how">{he ? 'איך זה עובד במשחק' : 'How it works in the game'}</h2>
      {he ? (
        <>
          <p>כל אירוע נפתח בחלון תאריכים. כשהתור מגיע לחלון, המשחק מציג את הכרטיס לשר האחראי, והשחקן בוחר אפשרות. האפשרות שסומנה כאן "מה שקרה בפועל" היא הבחירה ההיסטורית; האפשרויות האחרות הן חלופות שעמדו על הפרק או הנחות של עיצוב המשחק, וההערות בקובץ האירוע מציינות איפה מדובר בהנחה.</p>
          <p>לכל אפשרות יש השפעות על מדדי המשחק, כמו הביטחון, המורל והמעמד הבין־לאומי. הערכים האלה הם איזון של משחק ולא עובדות היסטוריות, ולוח "למה?" מראה בכל תור מה השתנה ומה גרם לכך.</p>
          <p>{`כל האירועים נבדקו מול המקורות שלהם. ${sensitiveCount} אירועים עם תגיות רגישות (מלחמה ונפגעים, טרור, שואה) עברו גם בדיקת רגישות, וכלי הבנייה מסרבים לארוז גרסה לשיתוף בלעדיה. שום היסטוריון עדיין לא בדק את המשחק; בדיקה כזו מתוכננת לאבן הדרך M4.`}</p>
          <p>מכיוון ש־GDD v0.1 הוא העיצוב המחייב עכשיו, המנגנון הזה ישתנה: לפי ה־GDD, השלמת מטרה תעלה כרטיס על האירוע ההיסטורי שקשור אליה, עם התאריך האמיתי שלו.</p>
        </>
      ) : (
        <>
          <p>Each event opens in a date window. When a turn reaches the window, the game puts the card to the minister in charge, and the player picks an option. The option marked “What happened” here is the historical choice; the others are alternatives that were on the table or design assumptions, and the comments in the event file note where an option is an assumption.</p>
          <p>Each option has effects on the game’s indicators, such as security, morale and international standing. Those values are game balance, not historical facts, and the “Why?” panel shows each turn what changed and why.</p>
          <p>{`Every event has been checked against its sources. ${sensitiveCount} events with sensitive tags (war casualties, terror, the Holocaust) have also had a sensitivity review, and the build tools refuse to package a shareable build without it. No historian has reviewed the game yet; that is planned for M4.`}</p>
          <p>Because GDD v0.1 is now the design of record, this will change: under the GDD, completing an objective brings up a card about the historical event tied to it, with its real date.</p>
        </>
      )}
      <p><a href={href(lang, 'history/sources')}>{t(lang, 'nav.sources')}</a></p>
    </section>
  </div>
</Layout>

<style>
  .opening { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; margin-block-end: 2.5rem; }
  @media (max-width: 56rem) { .opening { grid-template-columns: 1fr; } }
  .declaration p { margin-block-end: 0.35rem; }
  .decl-he { font-family: var(--serif-he); font-size: 1.3rem; line-height: 1.6; text-align: right; }
  .decl-en { font-family: var(--serif); font-size: 0.85rem; letter-spacing: 0.05em; color: var(--gold-light); margin-block-end: 1.1rem !important; text-align: left; }
  .decl-source { font-size: 0.9rem; color: var(--ink-dim); margin-block-start: 1rem !important; }
  .note { color: var(--ink-dim); font-size: 0.95em; border-block-start: 1px solid var(--gold-faint); padding-block-start: 0.8rem; }
  .years { position: sticky; inset-block-start: var(--header-h); z-index: 5; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding-block: 0.6rem; background: rgba(9, 14, 26, 0.96); border-block: 1px solid var(--gold-faint); margin-block-end: 1rem; }
  .years a { color: var(--gold-light); text-decoration: none; font-weight: 600; }
  .year-title { font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem); color: var(--gold); margin-block: 2.5rem 1rem; border-block-end: 1px solid var(--gold-faint); padding-block-end: 0.3rem; }
  .event { display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2rem); padding-block: 1.75rem; border-block-end: 1px solid var(--navy-line); }
  .event:not(:has(.event-photo)) .event-body { grid-column: 2; }
  @media (max-width: 60rem) {
    .event { grid-template-columns: 1fr; }
    .event:not(:has(.event-photo)) .event-body { grid-column: auto; }
  }
  .event-photo figcaption { font-size: 0.8rem; }
  .event-date { color: var(--gold); font-size: 0.95rem; margin-block-end: 0.2rem; }
  .event h3 { margin-block-end: 0.5rem; }
  .event-text { max-inline-size: var(--measure); }
  .choice { background: var(--navy-solid); border: 1px solid var(--gold-dim); border-radius: 2px; padding: 0.8rem 1.1rem; margin-block: 1rem; max-inline-size: var(--measure); }
  .choice h4 { font-size: 0.95rem; color: var(--gold); margin-block-end: 0.5rem; padding-block-end: 0.4rem; border-block-end: 1px solid var(--gold-faint); }
  .choice ul { margin: 0; padding-inline-start: 1.1rem; }
  .choice li { margin-block: 0.25rem; }
  .tag { display: inline-block; margin-inline-start: 0.5rem; font-size: 0.78rem; font-weight: 600; padding: 0.05em 0.5em; border: 1px solid var(--gold-dim); color: var(--gold-light); border-radius: 2px; }
  .sources summary { cursor: pointer; color: var(--ink-dim); font-size: 0.95rem; }
  .sources ul { font-size: 0.9rem; margin-block: 0.6rem; padding-inline-start: 1.1rem; overflow-wrap: anywhere; }
  .sources p { font-size: 0.9rem; }
  .how { margin-block-start: 3rem; }
</style>
