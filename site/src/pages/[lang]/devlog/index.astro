---
import Layout from '../../../layouts/Layout.astro';
import { type Lang, languages, t, formatDate, REPO } from '../../../i18n/ui';
import { posts } from '../../../lib/devlog';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
const list = posts(lang);
---
<Layout lang={lang} page="devlog" title={t(lang, 'nav.devlog')}
  description={he ? 'מה השתנה במשחק, מתוך יומן השינויים של המאגר.' : 'What changed in the game, from the repository’s changelog.'}>
  <div class="wrap page">
    <header class="page-head">
      <span class="eyebrow">{t(lang, 'nav.devlog')}</span>
      <h1>{he ? 'יומן פיתוח' : 'Devlog'}</h1>
      <p>{he
        ? 'רשומות קצרות על מה שהשתנה. הרשימה המלאה של השינויים נמצאת ביומן השינויים של המאגר (באנגלית).'
        : 'Short notes on what changed. The full list of changes is in the repository’s changelog.'}
        {' '}<a href={`${REPO}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a></p>
    </header>
    <div class="posts">
      {list.map((p) => (
        <article class="post prose" id={p.slug}>
          <p class="post-date"><time datetime={p.date}>{formatDate(lang, p.date)}</time></p>
          <h2><a href={`#${p.slug}`}>{p.title}</a></h2>
          <p.Content />
        </article>
      ))}
    </div>
  </div>
</Layout>
<style>
  .post { padding-block: 1.5rem 2rem; border-block-end: 1px solid var(--gold-faint); }
  .post-date { color: var(--gold); margin-block-end: 0.3rem; }
  .post h2 { margin-block-start: 0; }
  .post h2 a { color: var(--ink); text-decoration: none; }
  .post h2 a:hover { color: var(--gold-light); }
  .post :global(ul), .post :global(ol) { padding-inline-start: 1.3rem; }
</style>
