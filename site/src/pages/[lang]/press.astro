---
import ProsePage from '../../components/ProsePage.astro';
import { type Lang, languages, href, t } from '../../i18n/ui';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
---
<ProsePage lang={lang} page="press" name="press" navKey="nav.press"
  heading={he ? 'לעיתונות' : 'Press'}
  intro={he ? 'עובדות על המשחק, ואיך להשתמש בתמונות.' : 'Facts about the game, and how to use its images.'}
  description={he ? 'דף נתונים על Statecraft: Israel לעיתונאים.' : 'A factsheet on Statecraft: Israel for the press.'}>
  <p class="prose"><a class="btn" href={href(lang, 'media')}>{t(lang, 'nav.media')}</a></p>
</ProsePage>
