---
// A click-to-load video. Before the click the page has only a poster image and a button: no video bytes, and nothing
// from another site. A video hosted elsewhere (the cinematic trailer) is a plain link instead.
import { Picture } from 'astro:assets';
import MediaLabel from './MediaLabel.astro';
import { type Lang, asset, t } from '../i18n/ui';
import type { MediaVideo } from '../lib/media';
interface Props { video: MediaVideo; lang: Lang; sizes?: string }
const { video, lang, sizes = '(min-width: 76rem) 72rem, 100vw' } = Astro.props;
const sources = video.sources.map((s) => ({ src: s.src.startsWith('/') ? s.src : asset(s.src), type: s.type }));
const tracks = video.captions
  ? (['en', 'he'] as const).map((l) => ({ src: asset(video.captions![l]), srclang: l, label: l === 'he' ? 'עברית' : 'English', default: l === lang }))
  : [];
const meta = [video.title[lang], video.durationText && `${t(lang, 'video.length')} ${video.durationText}`, !video.sound && t(lang, 'video.nosound')].filter(Boolean).join(' · ');
---
<figure class="media" data-kind={video.kind}>
  <div class="media-frame">
    <MediaLabel lang={lang} kind={video.kind} build={video.build} />
    {video.kind !== 'engine' && <span class="ai-mark" aria-hidden="true">AI</span>}
    {video.link ? (
      <a class="facade" href={video.link} rel="noopener">
        <Picture src={video.poster} alt="" formats={['avif']} fallbackFormat="webp" widths={[640, 1280]} sizes={sizes} loading="lazy" />
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" /></svg></span>
        <span class="facade-meta">{meta} · <strong>{t(lang, 'video.github')}</strong></span>
      </a>
    ) : (
      <button type="button" class="facade" data-video={JSON.stringify({ sources, tracks })} aria-label={`${t(lang, 'video.play')}: ${video.title[lang]}`}>
        <Picture src={video.poster} alt="" formats={['avif']} fallbackFormat="webp" widths={[640, 1280]} sizes={sizes} loading="lazy" />
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" /></svg></span>
        <span class="facade-meta">{meta}</span>
      </button>
    )}
  </div>
  <figcaption>
    <strong>{video.title[lang]}.</strong> {video.description[lang]}
    {video.link ? <> {t(lang, 'video.github.note')}</> : <> {t(lang, 'video.loads')}</>}
  </figcaption>
</figure>

<script>
  // Replace the poster button with the video on click. Native controls give play, pause, captions and fullscreen.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button.facade[data-video]')) {
    btn.addEventListener('click', () => {
      const { sources, tracks } = JSON.parse(btn.dataset.video!);
      const v = document.createElement('video');
      v.className = 'video-el';
      v.controls = true;
      v.playsInline = true;
      v.preload = 'auto';
      v.setAttribute('aria-label', btn.getAttribute('aria-label') ?? '');
      for (const s of sources) {
        const el = document.createElement('source');
        el.src = s.src; el.type = s.type; v.append(el);
      }
      for (const tr of tracks) {
        const el = document.createElement('track');
        el.kind = 'captions'; el.src = tr.src; el.srclang = tr.srclang; el.label = tr.label; el.default = tr.default;
        v.append(el);
      }
      btn.replaceWith(v);
      v.focus();
      v.play().catch(() => {});
    });
  }
</script>
