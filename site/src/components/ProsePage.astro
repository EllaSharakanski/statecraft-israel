---
import Layout from '../layouts/Layout.astro';
import { type Lang, type Page, t } from '../i18n/ui';
import { prose } from '../lib/prose';
interface Props { lang: Lang; page: Page; name: string; navKey: Parameters<typeof t>[1]; heading: string; intro?: string; description: string }
const { lang, page, name, navKey, heading, intro, description } = Astro.props;
const { Content } = prose(lang, name);
---
<Layout lang={lang} page={page} title={t(lang, navKey)} description={description}>
  <div class="wrap page">
    <header class="page-head">
      <span class="eyebrow">{t(lang, navKey)}</span>
      <h1>{heading}</h1>
      {intro && <p>{intro}</p>}
    </header>
    <div class="prose"><Content /></div>
    <slot />
  </div>
</Layout>
<style>
  .prose :global(ul), .prose :global(ol) { padding-inline-start: 1.3rem; }
  .prose :global(h2) { margin-block-start: 2.2rem; }
</style>
