---
// One labelled image. AVIF with a WebP fallback, in several widths; the label sits on the image and is repeated in the
// caption, so it survives a crop, a screenshot or a narrow screen.
import { Picture, getImage } from 'astro:assets';
import MediaLabel from './MediaLabel.astro';
import { type Lang, t } from '../i18n/ui';
import type { MediaImage } from '../lib/media';
interface Props {
  item: MediaImage; lang: Lang; sizes?: string; eager?: boolean; caption?: boolean; widths?: number[]; class?: string;
  objectPosition?: string;
}
const { item, lang, sizes = '(min-width: 76rem) 36rem, (min-width: 48rem) 50vw, 100vw', eager = false, caption = true,
  widths = [480, 800, 1200, 1600], class: cls, objectPosition } = Astro.props;
const usable = widths.filter((w) => w <= item.src.width);
if (!usable.length) usable.push(item.src.width);
const full = await getImage({ src: item.src, width: Math.min(item.src.width, 2400), format: 'webp', quality: 82 });
---
<figure class:list={['media', cls, { portrait: item.src.height > item.src.width }]} data-kind={item.kind}>
  <div class="media-frame">
    <MediaLabel lang={lang} kind={item.kind} build={item.build} />
    {item.kind !== 'engine' && <span class="ai-mark" aria-hidden="true">AI</span>}
    {item.aiPart && <span class="ai-mark ai-mark-low" aria-hidden="true">AI</span>}
    <Picture src={item.src} alt={item.alt[lang]} formats={['avif']} fallbackFormat="webp" widths={usable} sizes={sizes}
      quality={68} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined} style={objectPosition ? `object-position:${objectPosition}` : undefined} />
  </div>
  {caption && (
    <figcaption>
      <strong>{item.title[lang]}</strong>
      {item.kind === 'concept' && <> · {t(lang, 'label.concept.target')}</>}
      {item.likeness && <> · {t(lang, 'label.likeness')}</>}
      {item.aiPart && <> · <span class="ai-part">{item.aiPart[lang]}</span></>}
      {' · '}<a href={full.src}>{t(lang, 'figure.full')}</a>
    </figcaption>
  )}
</figure>
